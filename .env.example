APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="Alhammadi Hospitals"
MAIL_REPLY_TO_ADDRESS=your-email@gmail.com

# Password for the 4 ClientTestUsersSeeder demo accounts (super/permission/branchA/branchB).
# Required for that seeder to run; set to a real temporary value before seeding.
# Quote the value if it contains '#' or spaces (.env treats an unquoted '#' as a comment).
CLIENT_TEST_PASSWORD=

HM_OTP_LENGTH=6
HM_OTP_EXPIRY_SECONDS=300
HM_OTP_RESEND_COOLDOWN_SECONDS=30
HM_OTP_MAX_ATTEMPTS=5
# Local only. Never enable on production — it shows the OTP on the verify page.
HM_OTP_DEMO_MODE=false

# compat preserves legacy implicit access while permissions are backfilled.
# Use strict after `php artisan hm:permissions:backfill --apply` is verified.
HM_PERMISSION_ENFORCEMENT_MODE=compat

# Corporate Communication department notifications / daily reminders
HM_CC_NOTIFICATIONS_ENABLED=false
HM_CC_NOTIFICATIONS_MAIL=true
HM_CC_NOTIFICATIONS_SMS=false
HM_CC_REMINDERS_ENABLED=true
HM_CC_REMINDERS_AT=07:00
HM_CC_REMINDERS_TIMEZONE=Asia/Riyadh

# License and regulatory permit management
HM_LICENSES_PER_PAGE=15
HM_LICENSES_YELLOW_DAYS=90
HM_LICENSES_REMINDER_DAYS=60
HM_LICENSES_RED_DAYS=30
HM_LICENSES_UNDERTAKING_DAYS=3
HM_LICENSES_EXPIRED_REESCALATE_DAYS=7
HM_LICENSES_SCHEDULER_AT=07:15
HM_LICENSES_TIMEZONE=Asia/Riyadh
HM_LICENSES_NOTIFICATIONS_ENABLED=true
HM_LICENSES_MAIL_ENABLED=true
HM_LICENSES_SMS_ENABLED=false

# SMS gateway: log (safe local) | mshastra | synapse
HM_SMS_PROVIDER=log
HM_SMS_SENDER=ALHAMMADI
HM_SMS_MSHASTRA_USER=
HM_SMS_MSHASTRA_PASSWORD=
HM_SMS_SYNAPSE_USER=
HM_SMS_SYNAPSE_PASSWORD=

# Saudi digital integrations. Supply the values issued for this environment.
SADQ_ENABLED=false
SADQ_BASE_URL=https://apigw.sadq.sa
SADQ_CLIENT_USERNAME=
SADQ_CLIENT_PASSWORD=
SADQ_AUTH_BASIC=
SADQ_INTEGRATION_USERNAME=
SADQ_INTEGRATION_PASSWORD=
SADQ_ACCOUNT_ID=
SADQ_ACCOUNT_SECRET=
SADQ_AVAILABLE_TO=2029-08-29
SADQ_CALLBACK_SECRET=
SADQ_TIMEOUT=60

YAQEEN_ENABLED=false
YAQEEN_BASE_URL=https://yakeencore.api.elm.sa
YAQEEN_USERNAME=
YAQEEN_PASSWORD=
YAQEEN_USAGE_CODE=
YAQEEN_OPERATOR_ID=
YAQEEN_APP_ID=
YAQEEN_APP_KEY=
YAQEEN_SAUDI_NATIONALITY_CODE=113
YAQEEN_TIMEOUT=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
